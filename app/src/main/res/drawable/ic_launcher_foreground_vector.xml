            </aapt:attr>
        </path>
        <!-- Isometric Left Face -->
        <path
            android:pathData="M 22,34 L 54,52 L 54,88 L 22,70 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="22"
                    android:startY="34"
                    android:endX="54"
                    android:endY="88"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00F0FF" />
                    <item android:offset="1.0" android:color="#3B82F6" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Isometric Right Face -->
        <path
            android:pathData="M 54,52 L 86,34 L 86,70 L 54,88 Z">
            <aapt:attr name="android:fillColor">
