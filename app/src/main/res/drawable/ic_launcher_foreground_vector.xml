                    android:startX="54"
                    android:startY="34"
                    android:endX="86"
                    android:endY="88"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00F0FF" />
                    <item android:offset="1.0" android:color="#8B5CF6" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Inner Isometric Edges -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2.4"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
            android:pathData="M 22,34 L 54,16 L 86,34 M 54,16 L 54,52" />
