            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="22"
                    android:startY="16"
                    android:endX="86"
                    android:endY="52"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#00F0FF" />
                    <item android:offset="1.0" android:color="#8B5CF6" />
